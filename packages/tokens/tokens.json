{
  "$description": "Base tokens of the pult design system. Studio-owned; clients never change these. Brand tokens come from the installation config and are merged at runtime by createTheme().",
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": { "none": 0, "sm": 6, "md": 10, "lg": 16, "xl": 24, "full": 9999 },
  "stroke": { "hairline": 1, "default": 1.5, "strong": 2, "focus": 3 },
  "touch": { "min": 44, "comfortable": 56, "large": 72 },
  "motion": {
    "duration": { "instant": 80, "fast": 150, "base": 220, "slow": 360 },
    "spring": { "damping": 22, "stiffness": 260, "mass": 1 }
  },
  "font": {
    "family": { "sans": "Inter", "mono": "JetBrains Mono" },
    "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
    "size": { "xs": 11, "sm": 13, "md": 15, "lg": 17, "xl": 22, "2xl": 28, "display": 40 },
    "lineHeight": { "xs": 14, "sm": 18, "md": 20, "lg": 24, "xl": 28, "2xl": 34, "display": 46 }
  },
  "control": {
    "faderTrack": 56,
    "faderThumb": 12,
    "knob": 88,
    "knobArc": 6,
    "xyDot": 28,
    "meterWidth": 12,
    "holdRing": 4,
    "gridGap": 8
  },
  "color": {
    "dark": {
      "background": "#22252C",
      "surface": "#282C34",
      "surfaceRaised": "#2F333C",
      "border": "#3A3F49",
      "text": "#E3E6EC",
      "textMuted": "#8B919D",
      "overlay": "#000000B3"
    },
    "light": {
      "background": "#E4E8EE",
      "surface": "#EAEDF2",
      "surfaceRaised": "#F1F3F7",
      "border": "#D2D7DF",
      "text": "#20242B",
      "textMuted": "#636A77",
      "overlay": "#0000004D"
    },
    "status": {
      "$description": "Never overridden by a brand: operators must recognise these on every pult.",
      "online": "#5CF27A",
      "warning": "#FFB02E",
      "critical": "#FF4D5E",
      "offline": "#6B717D",
      "studio": "#9B7BFF"
    }
  },
  "elevation": {
    "$description": "Neumorphic depth (ADR-013 addendum). Mirrors the Figma `elevation/*` variables and the Neu/* + Glow/* effect styles. Raised = interactive / top-level, inset = active / pressed / bed under a control, flat = info nested in a card. Glow only on lit values and while pressed.",
    "dark": {
      "shadow": "#08090D80",
      "shadowContact": "#08090D59",
      "highlight": "#FFFFFF05",
      "edgeLight": "#FFFFFF08",
      "edgeDark": "#05060840",
      "insetShadow": "#05060899",
      "insetHighlight": "#FFFFFF0D"
    },
    "light": {
      "shadow": "#8E98AA73",
      "shadowContact": "#8E98AA4D",
      "highlight": "#FFFFFFCC",
      "edgeLight": "#FFFFFF99",
      "edgeDark": "#8E98AA26",
      "insetShadow": "#8E98AA80",
      "insetHighlight": "#FFFFFFE6"
    },
    "effects": {
      "raised": [
        { "x": 8, "y": 12, "blur": 28, "spread": -4, "color": "shadow" },
        { "x": 2, "y": 3, "blur": 6, "spread": 0, "color": "shadowContact" },
        { "x": -8, "y": -8, "blur": 20, "spread": -2, "color": "highlight" },
        { "x": 0, "y": 1, "blur": 1, "spread": 0, "color": "edgeLight", "inset": true },
        { "x": 0, "y": -2, "blur": 6, "spread": 0, "color": "edgeDark", "inset": true }
      ],
      "raisedSm": [
        { "x": 4, "y": 6, "blur": 14, "spread": -2, "color": "shadow" },
        { "x": 1, "y": 2, "blur": 3, "spread": 0, "color": "shadowContact" },
        { "x": -4, "y": -4, "blur": 10, "spread": -1, "color": "highlight" },
        { "x": 0, "y": 1, "blur": 1, "spread": 0, "color": "edgeLight", "inset": true },
        { "x": 0, "y": -1, "blur": 4, "spread": 0, "color": "edgeDark", "inset": true }
      ],
      "inset": [
        { "x": 4, "y": 4, "blur": 10, "spread": 0, "color": "insetShadow", "inset": true },
        { "x": -3, "y": -3, "blur": 8, "spread": 0, "color": "insetHighlight", "inset": true }
      ],
      "pressed": [
        { "x": 3, "y": 3, "blur": 8, "spread": 0, "color": "insetShadow", "inset": true },
        { "x": -2, "y": -2, "blur": 6, "spread": 0, "color": "insetHighlight", "inset": true }
      ],
      "glow": [
        { "x": 0, "y": 0, "blur": 14, "spread": 0, "color": "glow" },
        { "x": 0, "y": 0, "blur": 4, "spread": 0, "color": "glow" }
      ]
    }
  },
  "brandDefaults": {
    "primary": "#8DFF2E",
    "accent": "#3DD6FF",
    "mode": "dark",
    "font": "Inter"
  }
}
