{
  "schemaVersion": 1,
  "installation": { "id": "demo", "name": "Demo installation", "revision": 1 },
  "targets": [
    {
      "id": "td",
      "name": "TouchDesigner",
      "protocol": "udp",
      "host": "auto",
      "port": 7000,
      "feedbackPort": 9000
    }
  ],
  "theme": { "mode": "dark", "primary": "#C6FF3D", "accent": "#3DD6FF" },
  "pults": [
    {
      "id": "lobby",
      "name": "Lobby wall",
      "defaultTarget": "td",
      "pages": [
        {
          "id": "live",
          "title": "Live",
          "controls": [
            {
              "id": "intensity",
              "type": "fader",
              "label": "Intensity",
              "address": "/wall/intensity",
              "curve": "log",
              "default": 0.6,
              "grid": { "x": 0, "y": 0, "w": 2, "h": 6 }
            },
            {
              "id": "speed",
              "type": "fader",
              "label": "Speed",
              "address": "/wall/speed",
              "min": 0,
              "max": 4,
              "default": 1,
              "unit": "×",
              "grid": { "x": 2, "y": 0, "w": 2, "h": 6 }
            },
            {
              "id": "position",
              "type": "xy",
              "label": "Focus point",
              "address": "/wall/focus",
              "grid": { "x": 4, "y": 0, "w": 5, "h": 6 }
            },
            {
              "id": "hue",
              "type": "knob",
              "label": "Hue shift",
              "address": "/wall/hue",
              "min": -180,
              "max": 180,
              "centered": true,
              "unit": "°",
              "grid": { "x": 9, "y": 0, "w": 3, "h": 3 }
            },
            {
              "id": "audio",
              "type": "meter",
              "label": "Audio",
              "feedback": "/wall/audio/level",
              "warnAt": 0.75,
              "criticalAt": 0.95,
              "grid": { "x": 9, "y": 3, "w": 1, "h": 3 }
            },
            {
              "id": "status",
              "type": "label",
              "label": "FPS",
              "feedback": "/sys/fps",
              "format": "{value} fps",
              "size": "lg",
              "grid": { "x": 10, "y": 3, "w": 2, "h": 3 }
            },
            {
              "id": "mode",
              "type": "segmented",
              "label": "Mode",
              "address": "/wall/mode",
              "options": [
                { "label": "Ambient", "value": "ambient" },
                { "label": "React", "value": "react" },
                { "label": "Show", "value": "show" }
              ],
              "grid": { "x": 0, "y": 6, "w": 6, "h": 2 }
            },
            {
              "id": "logo",
              "type": "toggle",
              "label": "Logo",
              "address": "/wall/logo",
              "grid": { "x": 6, "y": 6, "w": 2, "h": 2 }
            },
            {
              "id": "flash",
              "type": "button",
              "label": "Flash",
              "address": "/wall/flash",
              "grid": { "x": 8, "y": 6, "w": 2, "h": 2 }
            },
            {
              "id": "blackout",
              "type": "holdToConfirm",
              "label": "Blackout",
              "address": "/wall/blackout",
              "holdMs": 1500,
              "grid": { "x": 10, "y": 6, "w": 2, "h": 2 }
            }
          ]
        },
        {
          "id": "scenes",
          "title": "Scenes",
          "controls": [
            {
              "id": "scene",
              "type": "sceneList",
              "label": "Scene",
              "address": "/scene",
              "crossfade": 2,
              "scenes": [
                { "id": "morning", "label": "Morning", "value": 1 },
                { "id": "day", "label": "Day", "value": 2 },
                { "id": "evening", "label": "Evening", "value": 3 },
                { "id": "event", "label": "Event", "value": 4 }
              ],
              "grid": { "x": 0, "y": 0, "w": 6, "h": 8 }
            },
            {
              "id": "pads",
              "type": "buttonGrid",
              "label": "Cues",
              "address": "/cue/{index}",
              "rows": 3,
              "cols": 4,
              "mode": "radio",
              "grid": { "x": 6, "y": 0, "w": 6, "h": 5 }
            },
            {
              "id": "tint",
              "type": "colorPicker",
              "label": "Tint",
              "address": "/wall/tint",
              "swatches": ["#C6FF3D", "#3DD6FF", "#FF3D8B", "#FFFFFF"],
              "grid": { "x": 6, "y": 5, "w": 6, "h": 3 }
            }
          ]
        }
      ]
    }
  ]
}
