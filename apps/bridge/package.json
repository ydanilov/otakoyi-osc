{
  "name": "@osc/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/bridge.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:bin": "node scripts/build-bin.mjs"
  },
  "dependencies": {
    "@osc/bridge-core": "workspace:*",
    "@osc/controls": "workspace:*",
    "@osc/core": "workspace:*",
    "@osc/protocol": "workspace:*",
    "@osc/schema": "workspace:*",
    "bonjour-service": "^1.4.4",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "postject": "1.0.0-alpha.6"
  }
}
