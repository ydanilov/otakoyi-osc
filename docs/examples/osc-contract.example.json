{
  "contractVersion": 1.1,
  "installation": {
    "id": "demo",
    "name": "Demo installation",
    "useCase": "lobby"
  },
  "software": {
    "app": "touchdesigner",
    "version": "2025.x",
    "project": "otakoyi_test.toe",
    "os": "windows",
    "machines": 1
  },
  "osc": {
    "in": {
      "protocol": "udp",
      "port": 7000
    },
    "feedback": {
      "port": 9000,
      "aliveAddress": "/sys/fps"
    }
  },
  "parameters": [
    {
      "address": "/wall/intensity",
      "type": "float",
      "label": "Intensity",
      "min": 0,
      "max": 1,
      "default": 0.6,
      "feedback": true,
      "hint": "fader",
      "group": "Wall",
      "priority": "live"
    },
    {
      "address": "/wall/speed",
      "type": "float",
      "label": "Speed",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "feedback": true,
      "hint": "fader",
      "group": "Wall",
      "priority": "tune",
      "formFactors": ["tablet"]
    },
    {
      "address": "/wall/focus",
      "type": "xy",
      "label": "Focus point",
      "min": 0,
      "max": 1,
      "feedback": true,
      "hint": "xy",
      "group": "Wall",
      "priority": "live"
    },
    {
      "address": "/wall/hue",
      "type": "float",
      "label": "Hue shift",
      "min": 0,
      "max": 1,
      "feedback": true,
      "hint": "knob",
      "group": "Wall",
      "priority": "tune"
    },
    {
      "address": "/wall/mode",
      "type": "enum",
      "label": "Mode",
      "default": "ambient",
      "feedback": true,
      "hint": "segmented",
      "group": "Wall",
      "options": [
        {
          "value": "ambient",
          "label": "Ambient"
        },
        {
          "value": "react",
          "label": "React"
        },
        {
          "value": "show",
          "label": "Show"
        }
      ],
      "priority": "live"
    },
    {
      "address": "/wall/logo",
      "type": "bool",
      "label": "Logo",
      "default": false,
      "feedback": true,
      "hint": "toggle",
      "group": "Wall",
      "priority": "live"
    },
    {
      "address": "/wall/flash",
      "type": "trigger",
      "label": "Flash",
      "hint": "button",
      "group": "Wall",
      "priority": "live"
    },
    {
      "address": "/wall/blackout",
      "type": "trigger",
      "label": "Blackout",
      "dangerous": true,
      "hint": "holdToConfirm",
      "group": "Wall",
      "priority": "live"
    },
    {
      "address": "/wall/tint",
      "type": "color",
      "label": "Tint",
      "description": "Accepted as /wall/tint/h (degrees), /wall/tint/s and /wall/tint/b (0..1), each echoed.",
      "colorFormat": "hsb",
      "hueRange": "degrees",
      "feedback": true,
      "hint": "colorPicker",
      "group": "Wall",
      "priority": "tune"
    },
    {
      "address": "/scene",
      "type": "enum",
      "label": "Scene",
      "default": 1,
      "feedback": true,
      "hint": "sceneList",
      "group": "Scenes",
      "description": "Second argument: crossfade in seconds.",
      "options": [
        {
          "value": 1,
          "label": "Morning"
        },
        {
          "value": 2,
          "label": "Day"
        },
        {
          "value": 3,
          "label": "Evening"
        },
        {
          "value": 4,
          "label": "Event"
        }
      ],
      "priority": "live"
    },
    {
      "address": "/cue/{index}",
      "type": "trigger",
      "label": "Cue",
      "count": 12,
      "hint": "buttonGrid",
      "group": "Scenes",
      "priority": "tune"
    },
    {
      "address": "/system/resw",
      "type": "int",
      "label": "Screen Width px",
      "min": 16,
      "max": 16384,
      "default": 1920,
      "unit": "px",
      "feedback": true,
      "group": "System",
      "priority": "setup"
    },
    {
      "address": "/system/resh",
      "type": "int",
      "label": "Screen Height px",
      "min": 16,
      "max": 16384,
      "default": 1080,
      "unit": "px",
      "feedback": true,
      "group": "System",
      "priority": "setup"
    },
    {
      "address": "/system/debug",
      "type": "bool",
      "label": "Debug",
      "description": "Debug overlay",
      "default": false,
      "feedback": true,
      "group": "System",
      "priority": "setup"
    },
    {
      "address": "/system/seed",
      "type": "int",
      "label": "Seed",
      "description": "0 = random",
      "min": 0,
      "default": 0,
      "feedback": true,
      "group": "System",
      "priority": "setup"
    }
  ],
  "telemetry": [
    {
      "address": "/wall/audio/level",
      "type": "float",
      "label": "Audio",
      "min": 0,
      "max": 1,
      "rateHz": 10
    },
    {
      "address": "/sys/fps",
      "type": "float",
      "label": "FPS",
      "unit": "fps",
      "rateHz": 1
    }
  ],
  "actions": ["flash", "restart", "blackout", "idle"],
  "pairingOverlay": true
}
