{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ydanilov/otakoyi-osc/docs/osc-contract.schema.json",
  "title": "Otakoyi OSC contract",
  "description": "What an installation accepts and reports over OSC. Lives in the installation repo as otakoyi/osc-contract.json. See docs/integration.md.",
  "type": "object",
  "required": ["contractVersion", "installation", "osc", "parameters"],
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^/([^\\s#*,?\\[\\]{}]|\\{(index|row|col)\\})*$",
      "not": {
        "pattern": "^/(otakoyi|sys)(/|$)"
      },
      "description": "OSC address. May contain {index}, {row} or {col} placeholders. /otakoyi/* and /sys/* are reserved."
    },
    "value": {
      "type": ["number", "string", "boolean", "null"]
    }
  },
  "properties": {
    "contractVersion": {
      "enum": [1, 1.1],
      "description": "1.1 adds the optional parameter fields priority, order and formFactors; a 1.0 contract stays valid. Writers emit 1.1."
    },
    "installation": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "useCase": {
          "enum": ["lobby", "live", "both"],
          "description": "ADR-013: lobby controller (phone first) or live VJ console (tablet first)."
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": {
          "enum": [
            "touchdesigner",
            "touchplayer",
            "browser",
            "unreal",
            "unity",
            "resolume",
            "notch",
            "other"
          ]
        },
        "version": {
          "type": "string"
        },
        "project": {
          "type": "string",
          "description": "Project file, e.g. installation.toe"
        },
        "os": {
          "enum": ["windows", "macos", "linux"]
        },
        "machines": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "osc": {
      "type": "object",
      "required": ["in"],
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "object",
          "required": ["port"],
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "enum": ["udp", "tcp"],
              "default": "udp"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "feedback": {
          "type": "object",
          "required": ["port"],
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "aliveAddress": {
              "type": "string",
              "pattern": "^/",
              "description": "Optional; default /sys/fps. Must arrive at least every 5 s."
            }
          }
        },
        "heartbeat": {
          "type": "string",
          "pattern": "^/",
          "description": "Runtime heartbeat address (ADR-011), e.g. /sys/heartbeat."
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "type", "label"],
        "additionalProperties": false,
        "properties": {
          "address": {
            "$ref": "#/$defs/address"
          },
          "type": {
            "enum": ["float", "int", "bool", "trigger", "enum", "xy", "color", "string"]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Suggested label; final copy lives in Figma."
          },
          "description": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "default": {
            "$ref": "#/$defs/value"
          },
          "unit": {
            "type": "string"
          },
          "curve": {
            "enum": ["linear", "log", "exp"]
          },
          "options": {
            "type": "array",
            "description": "For type enum: allowed values with labels.",
            "items": {
              "type": "object",
              "required": ["value", "label"],
              "properties": {
                "value": {
                  "$ref": "#/$defs/value"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "description": "For template addresses: number of indices (0-based)."
          },
          "colorFormat": {
            "enum": ["hsb", "rgbFloat", "rgbInt", "hsvFloat", "hex"],
            "default": "hsb",
            "description": "For type color. hsb (default): three addresses <address>/h, <address>/s, <address>/b, each sent only when it changes and echoed on its own address. The others are one message on <address>: hsvFloat (h s v floats 0..1), rgbFloat (r g b 0..1), rgbInt (0..255), hex (\"#RRGGBB\")."
          },
          "hueRange": {
            "enum": ["degrees", "unit"],
            "default": "degrees",
            "description": "For colorFormat hsb: hue on <address>/h in degrees 0..360 or normalised 0..1."
          },
          "feedback": {
            "type": "boolean",
            "default": false,
            "description": "The installation echoes the current value on the same address."
          },
          "dangerous": {
            "type": "boolean",
            "default": false,
            "description": "Visible or irreversible effect on a live show; the pult uses hold-to-confirm."
          },
          "hint": {
            "type": "string",
            "description": "Suggested control type (fader, knob, xy, toggle, button, holdToConfirm, segmented, sceneList, buttonGrid, colorPicker, \u2026)."
          },
          "group": {
            "type": "string",
            "description": "Logical group, e.g. Wall, Scenes, Audio. \"System\" is the standard System group (ADR-018): exactly /system/resw, /system/resh (int, px), /system/debug (bool) and /system/seed (int); /system/* is reserved for it. The pult shows it as the System screen in the Installation panel, never on a project screen."
          },
          "priority": {
            "enum": ["live", "tune", "setup", "hidden"],
            "default": "tune",
            "description": "Who needs the parameter (help tags in otakoyi-td-template docs/standards.md \u00a74): live = show operator, first pult screen; tune = on-site tuning; setup = one-off, a separate Setup pult; hidden = never on a pult. Omitted: tune."
          },
          "order": {
            "type": "number",
            "description": "Order inside the group, ascending; ties keep the order of this array."
          },
          "formFactors": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": ["phone", "tablet"]
            },
            "description": "Where the parameter makes sense (ADR-013). Omitted: both."
          }
        }
      }
    },
    "telemetry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "type", "label"],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^/"
          },
          "type": {
            "enum": ["float", "int", "string", "bool"]
          },
          "label": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "rateHz": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["flash", "restart", "blackout", "idle", "pause"]
      },
      "description": "System actions handled via /otakoyi/<action> (docs/integration.md step 3)."
    },
    "pairingOverlay": {
      "type": "boolean",
      "description": "The installation shows the pairing card on /otakoyi/pair (tools/touchdesigner/otakoyi_pairing.tox)."
    },
    "notes": {
      "type": "string"
    }
  }
}
